## This env file only contains basic application information that can share and expose to other services e.g web, desktop, mobile
## Service specific configuration lives in the service directory e.g api/.env

APP_NAME=Sendocs
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
APP_LOCALE=en

POSTGRES_DB=sendocs
POSTGRES_USER=sendocs
POSTGRES_PASSWORD=sendocs

WEB_BIND=127.0.0.1
WEB_PORT=3000

# Local private S3-compatible object storage (RustFS)
S3_ACCESS_KEY_ID=sendocs-local-access
S3_SECRET_ACCESS_KEY=local-only-change-this-secret
S3_BUCKET=sendocs-private
S3_REGION=us-east-1
RUSTFS_BIND=127.0.0.1
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
