## Single environment file for the whole application.

# Application
APP_NAME=Sendocs
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Fixed development key.
APP_KEY=base64:ogjmfFBosRDfu9dgrWEdnsO1LmQt7TadBzCTEFRU5fM=

CSRF_SECRET="local-csrf-secret"

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sendocs
DB_USERNAME=sendocs
DB_PASSWORD=sendocs

# PostgreSQL container credentials.
POSTGRES_DB=sendocs
POSTGRES_USER=sendocs
POSTGRES_PASSWORD=sendocs

# Session, cache, and queues
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database

# Storage.
FILESYSTEM_DISK=s3

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail server
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage (S3-compatible)
AWS_ACCESS_KEY_ID=sendocs-local-access
AWS_SECRET_ACCESS_KEY=local-only-change-this-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sendocs-private
AWS_ENDPOINT=http://rustfs:9000
S3_BROWSER_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# RustFS credentials. Keep in step with the AWS credentials above.
RUSTFS_ACCESS_KEY=sendocs-local-access
RUSTFS_SECRET_KEY=local-change-this-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Compose ports and image targets
API_TARGET=dev
WEB_TARGET=dev
API_BIND=127.0.0.1
API_PORT=8000
WEB_BIND=127.0.0.1
WEB_PORT=3000
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Web (Vite)
VITE_APP_URL=http://localhost:3000
