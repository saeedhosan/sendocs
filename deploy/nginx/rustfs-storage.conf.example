# Example host-level Nginx virtual host for the browser-facing RustFS S3 API.
# Replace the hostname and certificate paths, install in the host's Nginx config,
# and reload Nginx after validating the configuration.
#
# The Compose service publishes RustFS only on 127.0.0.1:9000. Do not create a
# public virtual host for port 9001 (the RustFS management console).

server {
    listen 80;
    server_name storage.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name storage.example.com;

    ssl_certificate     /etc/letsencrypt/live/storage.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/storage.example.com/privkey.pem;

    # Signed URLs carry bearer credentials in their query string. Do not write
    # request targets, query strings, or signed URLs to access logs.
    access_log off;

    client_max_body_size 26m;

    location / {
        # No URI suffix: preserve the signed request path and query string.
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_request_buffering off;
        proxy_buffering off;
    }
}
