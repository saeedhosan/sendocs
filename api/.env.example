## This env file is only for the Laravel API service and is not shared with other services

APP_KEY=base64:KFu1QU6gr1zDA2alsABmC3/aLwh2oAFuJtttdurK6uM=
## The one origin the browser uses. Emails and links are built from it.
APP_URL=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sendocs
DB_USERNAME=sendocs
DB_PASSWORD=sendocs

## Owner sessions are rows in the `sessions` table, not Laravel sessions, so the
## session driver is unused here. The cookie itself is configured below.
SESSION_COOKIE=sendocs_session
SESSION_LIFETIME_DAYS=7
## Signs the session-bound CSRF token. Rotating it invalidates every outstanding token.
CSRF_SECRET=dev-only-csrf-secret-do-not-use-in-production

## Google OAuth. Leave blank to keep Google sign-in unconfigured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=debug

BCRYPT_ROUNDS=12

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Sendocs"