includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    parallel:
        maximumNumberOfProcesses: 4
    reportUnmatchedIgnoredErrors: false
    stubFiles:
        # - stubs/phpstan/your.stub
    paths:
        - app

    excludePaths:
        analyse:
            # - item
        analyseAndScan:
            ## Ignore especific files

    level: 5

    tmpDir: /tmp/phpstan

    ignoreErrors:
        - "#PHPDoc tag @var#"
